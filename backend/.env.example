DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POSTGRES_HOST:5432/grindly
ENVIRONMENT=production
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key":"replace-me","client_email":"replace-me"}
# Alternative for hosts that do not preserve raw JSON environment values.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
